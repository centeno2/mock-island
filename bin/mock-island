#!/usr/bin/env bash
set -euo pipefail

PROJECT="${MOCK_ISLAND_DIR:-$HOME/Projects/mock-island}"
BRIDGE="$PROJECT/backend/ai_bridge.py"
AGENT="$PROJECT/backend/agent_runtime.py"
VOICE="$PROJECT/backend/voice_bridge.py"
DESKTOP="$PROJECT/backend/desktop_adapter.py"
SERVICE="mock-island.service"

usage() {
  cat <<'EOF'
Mock Island

Uso:
  mock-island start|stop|restart|status|logs
  mock-island toggle|open|close       # controla la isla por IPC
  mock-island run                     # primer plano
  mock-island provider NOMBRE [MODELO]
  mock-island probe [NOMBRE]
  mock-island models [NOMBRE]          # lista modelos detectados
  mock-island key NOMBRE
  mock-island clear
  mock-island ask "mensaje"
  mock-island context [--clipboard]   # contexto del escritorio/media; clipboard solo si se pide
  mock-island theme
  mock-island agent-status            # herramientas y dependencias del agente
  mock-island agent "instrucción"      # prueba/ejecuta el agente desde terminal
  mock-island desktop-status          # entorno detectado y capacidades disponibles
  mock-island voice                   # inicia/detiene escucha desde la isla
  mock-island voice-start|voice-stop|voice-status
  mock-island voice-setup             # instala STT/TTS local (Whisper + Piper)
  mock-island doctor                  # comprueba integración Linux
  mock-island bind                    # instala atajos en Niri/Hyprland/Sway/i3 cuando es seguro

Proveedores:
  mock, ollama, lmstudio, openai, openrouter, anthropic, gemini, nvidia, custom
EOF
}

focused_output() {
  python3 "$DESKTOP" output 2>/dev/null || true
}

ensure_running() {
  if ! systemctl --user is-active --quiet "$SERVICE"; then
    systemctl --user start "$SERVICE"
    sleep 0.35
  fi
}

ipc_call() {
  ensure_running
  # -p selects this Quickshell configuration so DMS is not targeted by mistake.
  if qs -p "$PROJECT/shell.qml" ipc call mockIsland "$@" 2>/dev/null; then
    return 0
  fi
  qs ipc call mockIsland "$@"
}

setup_bind_niri() {
  local dir="$HOME/.config/niri" cfg="$HOME/.config/niri/config.kdl" bindfile="$HOME/.config/niri/mock-island.kdl"
  [[ -f "$cfg" ]] || return 1
  mkdir -p "$dir"
  if grep -RIn --include='*.kdl' --exclude='mock-island.kdl' -E '^[[:space:]]*Mod\+Space([[:space:]]|$)' "$dir" 2>/dev/null | head -n1 | grep -q .; then
    echo "⚠ Super+Espacio ya está ocupado en Niri; no lo sobrescribí." >&2; return 2
  fi
  cat > "$bindfile" <<EOF
binds {
    Mod+Space repeat=false hotkey-overlay-title="Mock AI" { spawn "$HOME/.local/bin/mock-island" "toggle"; }
    Mod+Alt+V repeat=false hotkey-overlay-title="Mock Voice" { spawn "$HOME/.local/bin/mock-island" "voice"; }
}
EOF
  cp -f "$cfg" "$cfg.mock-island.bak"
  grep -Fq 'include "mock-island.kdl"' "$cfg" || printf '\ninclude "mock-island.kdl"\n' >> "$cfg"
  if niri validate >/dev/null 2>&1; then
    niri msg action load-config-file >/dev/null 2>&1 || true
    echo "✓ Atajos instalados para Niri"; return 0
  fi
  cp -f "$cfg.mock-island.bak" "$cfg"
  echo "⚠ Niri rechazó la configuración; restauré el backup." >&2
  return 3
}

setup_bind_hyprland() {
  local cfg="$HOME/.config/hypr/hyprland.conf" inc="$HOME/.config/hypr/mock-island.conf"
  [[ -f "$cfg" ]] || return 1
  if grep -RIn --include='*.conf' -E 'bind[^=]*=[^,]*SUPER[^,]*,[[:space:]]*SPACE[[:space:]],' "$HOME/.config/hypr" 2>/dev/null | grep -v mock-island.conf | head -n1 | grep -q .; then
    echo "⚠ SUPER+SPACE ya está ocupado en Hyprland; no lo sobrescribí." >&2; return 2
  fi
  cat > "$inc" <<EOF
bind = SUPER, SPACE, exec, $HOME/.local/bin/mock-island toggle
bind = SUPER ALT, V, exec, $HOME/.local/bin/mock-island voice
EOF
  grep -Fq 'source = ~/.config/hypr/mock-island.conf' "$cfg" || printf '\nsource = ~/.config/hypr/mock-island.conf\n' >> "$cfg"
  hyprctl reload >/dev/null 2>&1 || true
  echo "✓ Atajos instalados para Hyprland"
}

setup_bind_i3like() {
  local backend="$1" cfg exe
  if [[ "$backend" == "sway" ]]; then cfg="$HOME/.config/sway/config"; exe="swaymsg"; else cfg="$HOME/.config/i3/config"; exe="i3-msg"; fi
  [[ -f "$cfg" ]] || return 1
  if grep -E '^[[:space:]]*bindsym[[:space:]]+\$mod\+space\b' "$cfg" >/dev/null 2>&1; then
    echo "⚠ \$mod+space ya está ocupado en $backend; no lo sobrescribí." >&2; return 2
  fi
  cp -f "$cfg" "$cfg.mock-island.bak"
  cat >> "$cfg" <<EOF

# Mock Island
bindsym \$mod+space exec $HOME/.local/bin/mock-island toggle
bindsym \$mod+Mod1+v exec $HOME/.local/bin/mock-island voice
EOF
  "$exe" reload >/dev/null 2>&1 || true
  echo "✓ Atajos instalados para $backend"
}

setup_bind() {
  local backend
  backend="$(python3 "$DESKTOP" status 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("backend","generic"))' 2>/dev/null || echo generic)"
  case "$backend" in
    niri) setup_bind_niri ;;
    hyprland) setup_bind_hyprland ;;
    sway|i3) setup_bind_i3like "$backend" ;;
    *)
      echo "· $backend: no modificaré los atajos del escritorio automáticamente."
      echo "  Asigna Super+Espacio a: $HOME/.local/bin/mock-island toggle"
      echo "  Y opcionalmente Super+Alt+V a: $HOME/.local/bin/mock-island voice"
      ;;
  esac
}

doctor() {
  local fail=0
  printf 'Mock Island · doctor\n\n'
  for cmd in qs python3; do
    if command -v "$cmd" >/dev/null 2>&1; then
      printf '  ✓ %-12s %s\n' "$cmd" "$(command -v "$cmd")"
    else
      printf '  ✗ %-12s no encontrado\n' "$cmd"
      fail=1
    fi
  done
  for cmd in wl-copy wl-paste xclip xsel playerctl notify-send wpctl pactl grim spectacle gnome-screenshot scrot pw-record pw-play; do
    if command -v "$cmd" >/dev/null 2>&1; then
      printf '  ✓ %-12s disponible\n' "$cmd"
    else
      printf '  · %-12s opcional\n' "$cmd"
    fi
  done
  local local_whisper="${XDG_DATA_HOME:-$HOME/.local/share}/mock-island/whisper.cpp/build/bin/whisper-cli"
  if command -v whisper-cli >/dev/null 2>&1; then
    printf '  ✓ %-12s %s\n' 'whisper' "$(command -v whisper-cli)"
  elif [[ -x "$local_whisper" ]]; then
    printf '  ✓ %-12s %s\n' 'whisper' "$local_whisper"
  else
    printf '  · %-12s ejecuta mock-island voice-setup\n' 'whisper'
  fi
  if [[ -f "${XDG_CACHE_HOME:-$HOME/.cache}/DankMaterialShell/dms-colors.json" ]]; then
    printf '  ✓ %-12s colores dinámicos detectados\n' 'DMS'
  else
    printf '  · %-12s usando paleta fallback\n' 'DMS'
  fi
  if systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
    printf '  ✓ %-12s activo\n' 'service'
  else
    printf '  · %-12s detenido\n' 'service'
  fi
  printf '\nDesktop adapter:\n'
  python3 "$DESKTOP" status | python3 -m json.tool || fail=1
  printf '\nContexto:\n'
  python3 "$BRIDGE" context | python3 -m json.tool || fail=1
  return "$fail"
}

cmd="${1:-}"
shift || true
case "$cmd" in
  start) systemctl --user start "$SERVICE" ;;
  stop) systemctl --user stop "$SERVICE" ;;
  restart) systemctl --user restart "$SERVICE" ;;
  status)
    systemctl --user status "$SERVICE" --no-pager || true
    echo
    python3 "$BRIDGE" status | python3 -m json.tool || true
    ;;
  logs) journalctl --user -u "$SERVICE" -f ;;
  run)
    export MOCK_ISLAND_DIR="$PROJECT"
    exec qs -p "$PROJECT/shell.qml"
    ;;
  toggle)
    out="$(focused_output)"
    ipc_call toggle "$out"
    ;;
  open)
    out="$(focused_output)"
    ipc_call open "$out"
    ;;
  close) ipc_call close ;;
  provider)
    [[ $# -ge 1 ]] || { usage; exit 2; }
    python3 "$BRIDGE" provider "$@" | python3 -m json.tool
    ;;
  probe)
    if [[ $# -ge 1 ]]; then
      python3 "$BRIDGE" probe --provider "$1" | python3 -m json.tool
    else
      python3 "$BRIDGE" status | python3 -m json.tool
    fi
    ;;
  models)
    provider="${1:-}"
    if [[ -n "$provider" ]]; then
      python3 "$BRIDGE" probe --provider "$provider" | python3 -c 'import json,sys; d=json.load(sys.stdin); print("\n".join(d.get("models", [])))'
    else
      python3 "$BRIDGE" status | python3 -c 'import json,sys; d=json.load(sys.stdin); print("\n".join(d.get("models", [])))'
    fi
    ;;
  key)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    python3 "$BRIDGE" key "$1"
    ;;
  clear) python3 "$BRIDGE" clear ;;
  ask)
    [[ $# -ge 1 ]] || { usage; exit 2; }
    printf '%s\n' "$*" | python3 "$BRIDGE" ask
    ;;
  context)
    python3 "$BRIDGE" context "$@" | python3 -m json.tool
    ;;
  theme) python3 "$BRIDGE" theme | python3 -m json.tool ;;
  agent-status) python3 "$AGENT" status | python3 -m json.tool ;;
  agent)
    [[ $# -ge 1 ]] || { usage; exit 2; }
    prompt="$*"
    provider="$(python3 "$BRIDGE" status | python3 -c 'import json,sys; print(json.load(sys.stdin).get("provider","mock"))')"
    model="$(python3 "$BRIDGE" status | python3 -c 'import json,sys; print(json.load(sys.stdin).get("model","") or "")')"
    plan="$(printf '%s\n' "$prompt" | python3 "$AGENT" plan --provider "$provider" --model "$model" --stdin)"
    printf '%s\n' "$plan" | python3 -m json.tool
    needs="$(printf '%s' "$plan" | python3 -c 'import json,sys; print("1" if json.load(sys.stdin).get("needs_confirmation") else "0")')"
    mode="$(printf '%s' "$plan" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("mode","chat"))')"
    if [[ "$mode" != agent ]]; then
      echo "· La solicitud fue clasificada como conversación; úsala desde la isla para chat."
      exit 0
    fi
    approved=()
    if [[ "$needs" == 1 ]]; then
      read -r -p '¿Ejecutar las acciones que requieren permiso? [s/N] ' answer
      [[ "$answer" =~ ^[sSyY]$ ]] || { echo 'Cancelado.'; exit 0; }
      approved=(--approved)
    fi
    printf '%s' "$plan" | python3 "$AGENT" execute --provider "$provider" --model "$model" "${approved[@]}" --stdin | python3 -m json.tool
    ;;
  desktop-status) python3 "$DESKTOP" status | python3 -m json.tool ;;
  voice)
    out="$(focused_output)"
    ipc_call voiceToggle "$out"
    ;;
  voice-start) python3 "$VOICE" record-start | python3 -m json.tool ;;
  voice-stop) python3 "$VOICE" record-stop | python3 -m json.tool ;;
  voice-status) python3 "$VOICE" status | python3 -m json.tool ;;
  voice-setup) exec "$PROJECT/scripts/setup-voice.sh" ;;
  doctor) doctor ;;
  bind) setup_bind ;;
  ""|-h|--help|help) usage ;;
  *) echo "Comando desconocido: $cmd" >&2; usage; exit 2 ;;
esac
